<Page x:Class="Anastasia423WPF.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог книг" Loaded="Page_Loaded" Background="#F5EFE6">

    <Grid Margin="20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Каталог книг" FontSize="26" FontFamily="Georgia" Foreground="#3D2B1F" FontWeight="Normal"/>
            <Rectangle Height="2" Fill="#C8A882" Margin="0,6,0,0" HorizontalAlignment="Left" Width="120"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15,12" Margin="0,0,0,18" BorderBrush="#E0D0BC" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" Foreground="#8C7B6B" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="#FDFAF6">
                    <TextBox x:Name="TBoxSearch" Width="200" Height="32" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Foreground="#3D2B1F" ToolTip="Поиск по названию" TextChanged="FilterChanged"/>
                </Border>
                <TextBlock Text="Жанр:" Foreground="#8C7B6B" FontSize="13" VerticalAlignment="Center" Margin="20,0,8,0"/>
                <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="#FDFAF6">
                    <ComboBox x:Name="ComboGenre" Width="150" Height="32" BorderThickness="0" Background="Transparent" Padding="8,0" FontSize="13" DisplayMemberPath="Name" SelectionChanged="FilterChanged"/>
                </Border>
                <TextBlock Text="Сортировка:" Foreground="#8C7B6B" FontSize="13" VerticalAlignment="Center" Margin="20,0,8,0"/>
                <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="#FDFAF6">
                    <ComboBox x:Name="ComboSort" Width="170" Height="32" BorderThickness="0" Background="Transparent" Padding="8,0" FontSize="13" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="Без сортировки"/>
                        <ComboBoxItem Content="Имя (А–Я)"/>
                        <ComboBoxItem Content="Имя (Я–А)"/>
                        <ComboBoxItem Content="Рейтинг (возр.)"/>
                        <ComboBoxItem Content="Рейтинг (убыв.)"/>
                    </ComboBox>
                </Border>
            </StackPanel>
        </Border>
        <ListBox x:Name="LBoxBooks" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="10" Margin="0,0,14,14" Width="195" BorderBrush="#E0D0BC" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#D0B89A" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border CornerRadius="10,10,0,0" ClipToBounds="True" Height="240">
                                <Image Source="{Binding Picture}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Margin="10,8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#3D2B1F" FontSize="14" TextTrimming="CharacterEllipsis" MaxHeight="40" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding GenresDisplay}" FontSize="10" Foreground="#A08060" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Rating, StringFormat='⭐ {0}'}" Foreground="#B07030" FontSize="12" Margin="0,4,0,6"/>
                                <Button Content="Подробнее" Height="30" Margin="0,2,0,6" Click="BtnRead_Click" Tag="{Binding}" FontSize="12" Foreground="White" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="#5C3D2E" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3D2B1F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <ComboBox x:Name="ComboStatus" Height="28" FontSize="11" SelectedValuePath="ID" DisplayMemberPath="Name" SelectionChanged="ComboStatus_SelectionChanged" Loaded="ComboStatus_Loaded" Tag="{Binding ID}" BorderBrush="#C8A882" Background="#FDFAF6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
