<Page x:Class="Anastasia423WPF.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои книги" Loaded="Page_Loaded" Background="#F5EFE6">

    <Grid Margin="20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Мои публикации" FontSize="26" FontFamily="Georgia"
                   Foreground="#3D2B1F" Margin="0,0,0,6"/>
        <Rectangle Grid.Row="1" Height="2" Fill="#C8A882" Margin="0,0,0,16"
                   HorizontalAlignment="Left" Width="140"/>

        <!-- Кнопка добавления -->
        <Button Grid.Row="2" Content="+ Добавить новую книгу" HorizontalAlignment="Left"
                Height="40" Padding="18,0" Margin="0,0,0,16"
                Click="BtnAddBook_Click" Cursor="Hand" Foreground="White" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#5C3D2E" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3D2B1F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Список книг автора -->
        <ListBox x:Name="LBoxAuthorBooks" Grid.Row="3" Background="Transparent"
                 BorderThickness="0" MouseDoubleClick="LBoxAuthorBooks_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="10" Margin="0,0,0,10"
                            Padding="16,14" BorderBrush="#E0D0BC" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="#3D2B1F"
                                           FontSize="16" FontWeight="SemiBold" FontFamily="Georgia"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Description}" Foreground="#7A6048"
                                           MaxHeight="38" TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Rating, StringFormat='⭐ {0}'}"
                                           Foreground="#B07030" FontSize="14" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Статус: " Foreground="#A08060" FontSize="12"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                               FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2" Content="Оспорить заморозку"
                                    Click="BtnAppeal_Click" Tag="{Binding}"
                                    Visibility="{Binding AppealVisibility}"
                                    Height="36" Padding="10,0" VerticalAlignment="Center"
                                    Background="#C0392B" Foreground="White"
                                    BorderThickness="0" FontSize="12" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>