<Page x:Class="Anastasia423WPF.Pages.Basket"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Basket">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FF672E2E" Padding="20">
            <TextBlock Text="🛒 Ваша корзина" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <ItemsControl x:Name="ItemsControlBasket" ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#FF672E2E" 
                                BorderThickness="0,0,0,2" 
                                Margin="0,0,0,10"
                                Padding="10"
                                Background="#FFF9F5F5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Картинка товара -->
                                <Image Source="{Binding ImagePath}" 
                                       Width="80" 
                                       Height="80"
                                       Margin="0,0,10,0"
                                       Stretch="Uniform"/>

                                <!-- Информация о товаре -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               Foreground="#FF672E2E"/>
                                    <TextBlock Text="{Binding Price, StringFormat='Цена: {0:C}'}" 
                                               FontSize="16"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Кнопка удаления -->
                                <Button Grid.Column="2" 
                                        Content="✕" 
                                        Width="30" 
                                        Height="30"
                                        Background="Red" 
                                        Foreground="White"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Click="BtnRemove_Click"
                                        Tag="{Binding ID}"
                                        ToolTip="Удалить из корзины"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.Template>
                    <ControlTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                            <ItemsPresenter Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </ItemsControl.Template>

                <!-- Сообщение при пустой корзине -->
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                                        <ItemsPresenter Margin="5"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="20">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🛒" FontSize="48" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Ваша корзина пуста" 
                                                               FontSize="18" 
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,10,0,0"/>
                                                    <TextBlock Text="Добавьте товары из каталога" 
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               Foreground="Gray"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </ScrollViewer>

        <!-- Итоговая сумма -->
        <Border Grid.Row="2" Background="#FFF0F0F0" Padding="15" Margin="10,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Общая сумма:" 
                           FontSize="18" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="txtTotalPrice" 
                           Grid.Column="1" 
                           Text="0 руб." 
                           FontSize="20" 
                           FontWeight="Bold"
                           Foreground="#FF672E2E"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <Grid Grid.Row="3" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопка назад -->
            <Button x:Name="BtnBack" 
                    Grid.Column="0" 
                    Content="← Вернуться к товарам" 
                    Margin="5,0" 
                    Padding="15"
                    Background="#FF672E2E" 
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Height="50"
                    Click="BtnBack_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Кнопка оформить заказ -->
            <Button x:Name="BtnCheckout" 
                    Grid.Column="1" 
                    Content="Оформить заказ →" 
                    Margin="5,0" 
                    Padding="15"
                    Background="#4CAF50" 
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Height="50"
                    Click="BtnCheckout_Click"
                    IsEnabled="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Page>
