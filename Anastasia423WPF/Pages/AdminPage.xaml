<Page x:Class="Anastasia423WPF.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администрирование" Loaded="Page_Loaded" Background="#F5EFE6">

    <Grid Margin="20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Панель управления" FontSize="26" FontFamily="Georgia" Foreground="#3D2B1F"/>
            <Rectangle Height="2" Fill="#C8A882" Margin="0,6,0,0" HorizontalAlignment="Left" Width="160"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="18,10"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="#7A6048"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}"
                                        Background="Transparent" Margin="0,0,4,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C8A882"/>
                                        <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0"/>
                                        <Setter TargetName="TabBorder" Property="CornerRadius" Value="8,8,0,0"/>
                                        <Setter Property="Foreground" Value="#3D2B1F"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ===== ПОЛЬЗОВАТЕЛИ ===== -->
            <TabItem Header="Пользователи">
                <Border Background="White" BorderBrush="#E0D0BC" BorderThickness="1"
                        Padding="16" CornerRadius="0,8,8,8">
                    <DataGrid x:Name="DGridUsers" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" RowBackground="White"
                              AlternatingRowBackground="#FDF8F4" Foreground="#3D2B1F"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0E4D4">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5EDE0"/>
                                <Setter Property="Foreground" Value="#5C3D2E"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="BorderBrush" Value="#E0D0BC"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}"
                                                IsReadOnly="True" Width="*" FontSize="13"/>
                            <DataGridTemplateColumn Header="Роль" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding RoleID, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="id" DisplayMemberPath="Name"
                                                  SelectionChanged="RoleComboBox_SelectionChanged"
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=AllRoles}"
                                                  BorderBrush="#C8A882" Background="#FDFAF6"
                                                  FontSize="12" Margin="4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Заморожен" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsFreeze, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" Click="FreezeCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Действие" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Сменить пароль" Click="BtnChangePass_Click"
                                                Tag="{Binding}" FontSize="12" Padding="8,4"
                                                Background="#F5EDE0" Foreground="#5C3D2E"
                                                BorderBrush="#C8A882" BorderThickness="1" Margin="4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- ===== ЖАЛОБЫ ===== -->
            <TabItem Header="Жалобы">
                <Border Background="White" BorderBrush="#E0D0BC" BorderThickness="1"
                        Padding="16" CornerRadius="0,8,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Фильтр по типу жалобы -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Показать:" Foreground="#7A6048" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="RbAll" Content="Все" GroupName="ReportFilter"
                                         IsChecked="True" Checked="ReportFilter_Changed"
                                         Foreground="#3D2B1F" FontSize="13" Margin="0,0,14,0"
                                         VerticalAlignment="Center"/>
                            <RadioButton x:Name="RbBooks" Content="На книги" GroupName="ReportFilter"
                                         Checked="ReportFilter_Changed"
                                         Foreground="#3D2B1F" FontSize="13" Margin="0,0,14,0"
                                         VerticalAlignment="Center"/>
                            <RadioButton x:Name="RbAuthors" Content="На авторов" GroupName="ReportFilter"
                                         Checked="ReportFilter_Changed"
                                         Foreground="#3D2B1F" FontSize="13" Margin="0,0,14,0"
                                         VerticalAlignment="Center"/>
                            <RadioButton x:Name="RbReviews" Content="На отзывы" GroupName="ReportFilter"
                                         Checked="ReportFilter_Changed"
                                         Foreground="#3D2B1F" FontSize="13"
                                         VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Список жалоб -->
                        <ListBox x:Name="LBoxReports" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0D0BC" BorderThickness="1"
                                            Margin="0,0,0,10" Padding="16,12"
                                            CornerRadius="8" Background="#FDFAF6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Информация о жалобе -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                                <!-- Тип жалобы (бейдж) -->
                                                <Border HorizontalAlignment="Left" CornerRadius="4"
                                                        Padding="8,3" Margin="0,0,0,8"
                                                        Background="{Binding ReportTypeBadgeColor, Mode=OneWay}">
                                                    <TextBlock Text="{Binding ReportTypeLabel, Mode=OneWay}"
                                                               Foreground="White" FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Цель жалобы -->
                                                <TextBlock Text="{Binding TargetDescription, Mode=OneWay}"
                                                           Foreground="#3D2B1F" FontWeight="SemiBold"
                                                           FontSize="14" Margin="0,0,0,4"
                                                           TextWrapping="Wrap"/>

                                                <!-- Кто пожаловался -->
                                                <TextBlock Foreground="#8C7B6B" FontSize="12">
                                                    <Run Text="Жалоба от: "/>
                                                    <Run Text="{Binding ReporterLogin, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="  •  "/>
                                                    <Run Text="{Binding ReportDateFormatted, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Кнопки действий -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Button Content="Одобрить и заморозить"
                                                        Click="BtnAcceptReport_Click" Tag="{Binding}"
                                                        Padding="14,7" Margin="0,0,10,0"
                                                        Background="#C0392B" Foreground="White"
                                                        BorderThickness="0" FontSize="12"
                                                        Cursor="Hand"/>
                                                <Button Content="Отклонить"
                                                        Click="BtnDeclineReport_Click" Tag="{Binding}"
                                                        Padding="14,7"
                                                        Background="#FFF0E8" Foreground="#8C4030"
                                                        BorderBrush="#E0B8A8" BorderThickness="1"
                                                        FontSize="12" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ===== ЗАЯВКИ НА РАЗМОРОЗКУ ===== -->
            <TabItem Header="Заявки на разморозку">
                <Border Background="White" BorderBrush="#E0D0BC" BorderThickness="1"
                        Padding="16" CornerRadius="0,8,8,8">
                    <ListBox x:Name="LBoxUnfreezeRequests" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0D0BC" BorderThickness="1"
                                        Margin="0,0,0,10" Padding="16,12"
                                        CornerRadius="8" Background="#FDFAF6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold"
                                                   Foreground="#5C3D2E" FontSize="14" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding requestText}" TextWrapping="Wrap"
                                                   Foreground="#4A3828" FontSize="13" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Разморозить" Click="BtnAcceptUnfreeze_Click"
                                                    Tag="{Binding}" Padding="14,6" Margin="0,0,10,0"
                                                    Background="#7A9E7E" Foreground="White"
                                                    BorderThickness="0" FontSize="12" Cursor="Hand"/>
                                            <Button Content="Отклонить" Click="BtnDeclineUnfreeze_Click"
                                                    Tag="{Binding}" Padding="14,6"
                                                    Background="#FFF0E8" Foreground="#8C4030"
                                                    BorderBrush="#E0B8A8" BorderThickness="1"
                                                    FontSize="12" Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>

            <!-- ===== ЗАЯВКИ НА АВТОРА ===== -->
            <TabItem Header="Заявки на автора">
                <Border Background="White" BorderBrush="#E0D0BC" BorderThickness="1"
                        Padding="16" CornerRadius="0,8,8,8">
                    <ListBox x:Name="LBoxRoleRequests" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0D0BC" BorderThickness="1"
                                        Margin="0,0,0,10" Padding="16,12"
                                        CornerRadius="8" Background="#FDFAF6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding UserName}"
                                                   VerticalAlignment="Center" Foreground="#3D2B1F"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Сделать автором" Click="BtnAcceptAuthor_Click"
                                                    Tag="{Binding}" Padding="14,6" Margin="0,0,10,0"
                                                    Background="#5C3D2E" Foreground="White"
                                                    BorderThickness="0" FontSize="12" Cursor="Hand"/>
                                            <Button Content="Отказать" Click="BtnDeclineAuthor_Click"
                                                    Tag="{Binding}" Padding="14,6"
                                                    Background="#FFF0E8" Foreground="#8C4030"
                                                    BorderBrush="#E0B8A8" BorderThickness="1"
                                                    FontSize="12" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>