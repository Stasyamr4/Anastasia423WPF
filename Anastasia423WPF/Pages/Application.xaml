<Page x:Class="Anastasia423WPF.Pages.Application"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Application">

    <Grid Background="WhiteSmoke">
        <StackPanel>
            <TextBlock Text="Оформление заявки" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15" FontSize="18" Foreground="#FFC83A0F" FontWeight="Bold"></TextBlock>
            <TextBlock Text="Введите Ваше имя в поле ниже" VerticalAlignment="Center" Margin="10" HorizontalAlignment="Center" FontSize="16"></TextBlock>
            <TextBox TextWrapping="Wrap" x:Name="UserName"  Text="имя сюда писать" Width="151" Margin="10" FontSize="16" PreviewTextInput ="UserName_PreviewTextInput" LostFocus="User_LostFocus"/>
            <TextBlock Text="Введите номер телефона в поле ниже" VerticalAlignment="Center" Margin="10" HorizontalAlignment="Center" FontSize="16"></TextBlock>
            <TextBox TextWrapping="Wrap" x:Name="UserPhone"  Text="а сюда телефончик" Width="171" Margin="10" FontSize="16" PreviewTextInput="UserPhone_PreviewTextInput" LostFocus="User_LostFocus"/>
            <TextBlock Text="Введите электронную почту" VerticalAlignment="Center" Margin="10" HorizontalAlignment="Center" FontSize="16"></TextBlock>
            <TextBox TextWrapping="Wrap" x:Name="UserEmail"  Text="напишите сюда почту" Width="189" Margin="10" FontSize="16" LostFocus="User_LostFocus"/>
            <Button x:Name="ApplicationBut" Content="Оформить заявку" Width="272" Height="43" Margin="30" IsEnabled="False" Click="ApplicationBut_Click"></Button>
        </StackPanel>
    </Grid>
</Page>
