<Page x:Class="Anastasia423WPF.NewFolder1.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Оформление заказа"
      Background="#FFF9F9F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Background="#FF2E8B57" Height="70">
            <TextBlock Text="Оформление заказа" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <StackPanel>
                <!-- Данные заказа -->
                <Border BorderBrush="#E0E0E0" 
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="White"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Данные покупателя" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="#FF2E8B57"
                                   Margin="0,0,0,15"/>

                        <!-- ФИО -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="ФИО *" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtFio" 
                                     FontSize="14"
                                     Padding="10"
                                     Height="35"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Email *" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtEmail" 
                                     FontSize="14"
                                     Padding="10"
                                     Height="35"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"/>
                        </StackPanel>

                        <!-- Адрес -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Адрес доставки *" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtAddress" 
                                     FontSize="14"
                                     Padding="10"
                                     Height="60"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- Дата заказа (только для отображения) -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Дата заказа" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <Border Background="#F8F8F8" 
                                    BorderBrush="#CCCCCC" 
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Height="35">
                                <TextBlock x:Name="txtOrderDate" 
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Товары в заказе -->
                <Border BorderBrush="#E0E0E0" 
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="White"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Товары в заказе" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="#FF2E8B57"
                                   Margin="0,0,0,15"/>

                        <ListBox x:Name="listBoxOrder" 
                                 MaxHeight="250"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F0F0" 
                                            BorderThickness="0,0,0,1"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Price, StringFormat='{}{0} ₽'}" 
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E74C3C"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Итоговая сумма -->
                        <Border Background="#F8F8F8" 
                                CornerRadius="4"
                                Padding="15"
                                Margin="0,15,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Общая сумма:" 
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="txtTotalPrice" 
                                           Grid.Column="1"
                                           Text="0 ₽"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FF2E8B57"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1,1,0,0"
                Height="70">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка назад -->
                <Button x:Name="btnBack" 
                        Grid.Column="0"
                        Content="← Назад" 
                        HorizontalAlignment="Left"
                        Padding="20,10"
                        FontSize="14" 
                        FontWeight="Bold"
                        Click="BtnBack_Click"
                        Background="#95A5A6"
                        Foreground="White"
                        BorderThickness="0"
                        Width="120"/>

                <!-- Кнопка оформить заказ -->
                <Button x:Name="btnConfirm" 
                        Grid.Column="1"
                        Content="Подтвердить заказ" 
                        HorizontalAlignment="Right"
                        Padding="25,10"
                        FontSize="15" 
                        FontWeight="Bold"
                        Click="BtnConfirm_Click"
                        Background="#FF2E8B57"
                        Foreground="White"
                        BorderThickness="0"
                        Width="180"/>
            </Grid>
        </Border>
    </Grid>
</Page>