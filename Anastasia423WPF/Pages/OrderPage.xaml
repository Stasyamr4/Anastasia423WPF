<Page x:Class="Anastasia423WPF.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Оформление заказа"
      Background="#FFF9F9F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Background="#FF2E8B57" Height="70">
            <TextBlock Text="Оформление заказа" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <StackPanel>
                <!-- Данные заказа -->
                <Border BorderBrush="#E0E0E0" 
        BorderThickness="1"
        CornerRadius="6"
        Background="White"
        Padding="25"
        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Данные покупателя" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Foreground="#2E86C1"
                   Margin="0,0,0,20"/>

                        <!-- ФИО -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="ФИО *" 
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtFio" 
                     FontSize="14"
                     Height="40"
                     VerticalContentAlignment="Center"
                     BorderBrush="#DDDDDD"
                     BorderThickness="1"
                     Background="#FAFAFA"/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Email *" 
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtEmail" 
                     FontSize="14"
 
                     Height="40"
                     VerticalContentAlignment="Center"
                     BorderBrush="#DDDDDD"
                     BorderThickness="1"
                     Background="#FAFAFA"/>
                        </StackPanel>

                        <!-- Адрес -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Адрес доставки *" 
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtAddress" 
                     FontSize="14"
                     Height="80"
                     VerticalContentAlignment="Top"
                     BorderBrush="#DDDDDD"
                     BorderThickness="1"
                     Background="#FAFAFA"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- Дата заказа -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Дата заказа" 
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
                            <Border Background="#F5F5F5" 
                    BorderBrush="#DDDDDD" 
                    BorderThickness="1"
                    CornerRadius="3"
                    Height="40">
                                <TextBlock x:Name="txtOrderDate" 
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="#666666"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Товары в заказе -->
                <Border BorderBrush="#E0E0E0" 
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="White"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Товары в заказе" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="#FF2E8B57"
                                   Margin="0,0,0,15"/>

                        <ListBox x:Name="listBoxOrder" 
                                 MaxHeight="250"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F0F0" 
                                            BorderThickness="0,0,0,1"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Price, StringFormat='{}{0} ₽'}" 
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E74C3C"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Итоговая сумма -->
                        <Border Background="#F8F8F8" 
                                CornerRadius="4"
                                Padding="15"
                                Margin="0,15,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Общая сумма:" 
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="txtTotalPrice" 
                                           Grid.Column="1"
                                           Text="0 ₽"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FF2E8B57"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" 
        Background="White" 
        BorderBrush="#E0E0E0" 
        BorderThickness="1,1,0,0"
        Height="70">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка назад -->
                <Button x:Name="btnBack" 
                Grid.Column="1"
                HorizontalAlignment="Center"
                Padding="20,8"
                FontSize="14" 
                FontWeight="SemiBold"
                Click="BtnBack_Click"
                Background="Transparent"
                Foreground="#7F8C8D"
                BorderBrush="#BDC3C7"
                BorderThickness="1"
                Width="130"
                Height="36">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="←" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Назад"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="4"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8F9F9"/>
                                    <Setter Property="BorderBrush" Value="#7F8C8D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Кнопка оформить заказ -->
                <Button x:Name="btnConfirm" 
                Grid.Column="3"
                HorizontalAlignment="Center"
                Padding="20,10"
                FontSize="15" 
                FontWeight="Bold"
                Click="BtnConfirm_Click"
                Background="#2E86C1"
                Foreground="White"
                BorderThickness="0"
                Width="170"
                Height="40">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✓" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Подтвердить"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2874A6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1B4F72"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>