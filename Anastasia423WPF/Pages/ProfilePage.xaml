<Page x:Class="Anastasia423WPF.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет" Background="#F5EFE6">

    <ScrollViewer Padding="25,20">
        <StackPanel>
            <TextBlock Text="Личный кабинет" FontSize="26" FontFamily="Georgia"
                       Foreground="#3D2B1F" Margin="0,0,0,6"/>
            <Rectangle Height="2" Fill="#C8A882" Margin="0,0,0,20"
                       HorizontalAlignment="Left" Width="140"/>
            <Border Background="White" CornerRadius="12" Padding="24"
                    BorderBrush="#E0D0BC" BorderThickness="1" Margin="0,0,0,22">
                <Border.Effect>
                    <DropShadowEffect Color="#C8A882" BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32"
                            Background="#E8D5B7" VerticalAlignment="Top" Margin="0,0,20,0">
                        <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TBlockFIO" FontSize="20" FontFamily="Georgia"
                                   Foreground="#3D2B1F" Text="ФИО: " Margin="0,0,0,6"/>
                        <TextBlock x:Name="TBlockEmail" FontSize="14" Foreground="#7A6048"
                                   Text="Email: " Margin="0,0,0,6"/>
                        <Border Background="#FFF8F0" CornerRadius="5" Padding="8,4"
                                HorizontalAlignment="Left" BorderBrush="#E8D5B7" BorderThickness="1">
                            <TextBlock x:Name="TBlockRole" FontSize="13" Foreground="#B07030"
                                       FontWeight="SemiBold" Text="Роль: "/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Мои отзывы" FontSize="18" FontFamily="Georgia"
                       Foreground="#3D2B1F" Margin="0,0,0,6"/>
            <Rectangle Height="1" Fill="#E0D0BC" Margin="0,0,0,12"/>
            <ListBox x:Name="LBoxMyReviews" Height="260" Background="White"
                     BorderBrush="#E0D0BC" BorderThickness="1"
                     MouseDoubleClick="LBoxMyReviews_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#F0E4D4" BorderThickness="0,0,0,1"
                                Padding="14,10" Tag="{Binding BookID}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <TextBlock Text="Книга: " Foreground="#A08060" FontSize="12"/>
                                    <TextBlock Text="{Binding BookName}" Foreground="#5C3D2E"
                                               FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="  •  ⭐ " Foreground="#C0A070" Margin="6,0,0,0" FontSize="12"/>
                                    <TextBlock Text="{Binding Rating}" Foreground="#B07030"
                                               FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Description}" Grid.Row="1"
                                           Foreground="#4A3828" TextWrapping="Wrap"
                                           Margin="0,5,0,0" FontSize="13" FontStyle="Italic"
                                           MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Name="ExitButton" Height="38" Padding="18,0"
                        Background="#C0392B" Foreground="White" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="ExitButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#A93226"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    Выйти из аккаунта
                </Button>

                <Button Name="RequestButton" Height="38" Padding="18,0" Margin="15,0,0,0"
                        Background="#7A9E7E" Foreground="White" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="RequestButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#5C7D60"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    Заявка на роль автора
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
