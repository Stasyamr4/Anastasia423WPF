<Page x:Class="Anastasia423WPF.Pages.ShowDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ShowDetails">

    <Grid Background="#FF676569">
        <StackPanel>
            <TextBlock x:Name="MyCar" Text="Выбранная машина: " HorizontalAlignment="Center" Margin="15" FontSize="16"></TextBlock>
            <TextBlock x:Name="Engine" Text="Двигатель: " HorizontalAlignment="Center" Margin="15" FontSize="16"></TextBlock>
            <TextBlock x:Name="Dop" Text="Доп. опции: " HorizontalAlignment="Center" Margin="15" FontSize="16"></TextBlock>
            <TextBlock x:Name="ColorCar" Text="Цвет машины: " HorizontalAlignment="Center" Margin="15" FontSize="16"></TextBlock>
            <TextBlock x:Name="PriceCar" Text="Конечная стоимость машины: " HorizontalAlignment="Center" Margin="15" FontSize="16"></TextBlock>
        </StackPanel>
    </Grid>
</Page>
