<Page x:Class="Anastasia423WPF.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFF5D0EF"/>
                <GradientStop Color="#FF220235" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Button x:Name="Enter" Width="100" Height="35" FontSize="20" Background="#FFF7E693" FontWeight="SemiBold"  Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30" Click="Enter_Click">Войти</Button>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Padding="20" FontSize="36" Foreground="White">Читай, Пиши и не спиши</TextBlock>
            <TextBlock Padding="10" FontSize="28" FontWeight="Thin"  Foreground="White" HorizontalAlignment="Center">Войдите в аккаунт</TextBlock>
            <TextBlock  HorizontalAlignment="Center" Margin="0,0,0,15" FontSize="20" FontWeight="Thin"  Foreground="White" >Введите логин</TextBlock>
            <TextBox x:Name="LoginText"  Width="140" Height="30" Background="#B2FFFFFF"></TextBox>
            <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="20" FontWeight="Thin"  Foreground="White">Введите пароль</TextBlock>
            <PasswordBox x:Name="PassText" Width="140" Height="30" Background="#B2FFFFFF" Margin="0,15,0,0"></PasswordBox>
            <TextBlock  HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="18" FontWeight="Thin"  Foreground="White">Нет аккаунта?</TextBlock>
            <Button x:Name="Registr"  Width="200"  Foreground="Gold"  Background="Transparent" FontWeight="DemiBold" FontSize="16" FontFamily="Arial Black" Click="Registr_Click">Зарегистрируйтесь</Button>
        </StackPanel>
    </Grid>
</Page>
