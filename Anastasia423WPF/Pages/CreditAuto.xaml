<Page x:Class="Anastasia423WPF.Pages.CreditAuto"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreditAuto">

    <Grid Background="#FFD66060">
        <StackPanel>
            <TextBlock x:Name="SliderMan" Text="Процент первоначального взноса" HorizontalAlignment="Center" Margin="30" FontSize="18" />
            <Slider x:Name="PercentCred" Maximum="70" Minimum="10"  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="25" Width="227" Height="22" Thumb.DragCompleted="PercentCred_DragCompleted"/>
            <TextBlock x:Name="Slay" Text="Срок кредита (в месяцах)" HorizontalAlignment="Center" Margin="10" FontSize="18" />
            <Slider HorizontalAlignment="Center" Maximum="96" Minimum="12" x:Name="SrokCred" Margin ="10" VerticalAlignment="Top" Width="227" Height="22" Thumb.DragCompleted="SrokCred_DragCompleted"/>
            <TextBlock x:Name="PercentText" Text="Процент кредита: " HorizontalAlignment="Center" Margin="10" VerticalAlignment="Center" FontSize="16" Visibility="Hidden"/>
            <TextBlock x:Name="YearText" Text="Срок кредита: " HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="15" Visibility="Hidden"></TextBlock>
            <TextBlock x:Name="MonthPay" Text="Ваш ежемесячный платеж составляет" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="20"></TextBlock>
            <Button x:Name="NextBut" Content="Далее" FontSize="16" Height="38" Width="122" Click="NextBut_Click"/>
        </StackPanel>
    </Grid>
</Page>
