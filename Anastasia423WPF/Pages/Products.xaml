<Page x:Class="Anastasia423WPF.NewFolder1.Products"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.NewFolder1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Products">

    <Grid>
        <!-- Простой заголовок -->
        <TextBlock Text="Каталог товаров" 
                   FontSize="26" 
                   FontWeight="Bold" 
                   Foreground="#FF2C3E50" 
                   VerticalAlignment="Top" 
                   HorizontalAlignment="Center"
                   Margin="0,25,0,0"/>

        <!-- Список товаров -->
        <ListBox x:Name="listBox" 
                 Margin="25,70,25,70"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Карточка товара -->
                    <Border BorderBrush="#E0E0E0" 
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            Margin="12,8"
                            Width="240"
                            Height="290">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#CCCCCC"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Область картинки -->
                            <Border Grid.Row="0" 
                                    Background="#F8F8F8" 
                                    CornerRadius="6,6,0,0">
                                <Image Source="{Binding ImagePath}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       MaxWidth="180"
                                       MaxHeight="110"/>
                            </Border>

                            <!-- Информация -->
                            <StackPanel Grid.Row="1" 
                                        Margin="15,10">
                                <TextBlock Text="{Binding Name}" 
                                           HorizontalAlignment="Center" 
                                           TextWrapping="Wrap"
                                           FontSize="15" 
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           TextAlignment="Center"/>

                                <!-- Цена в рублях -->
                                <TextBlock Text="{Binding Price, StringFormat='{}{0} ₽'}" 
                                           HorizontalAlignment="Center"
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Foreground="#E74C3C"
                                           Margin="0,10,0,0"/>
                            </StackPanel>

                            <!-- Кнопка в корзину -->
                            <Button Grid.Row="2"
                                    Content="Добавить в корзину" 
                                    Margin="20,0,20,15"
                                    Padding="10,6"
                                    Click="ToBasket_Click"
                                    Tag="{Binding ID}"
                                    Background="#3498DB"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand">
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Кнопка внизу -->
        <Border Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1,1,0,0"
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Stretch"
                Height="55">
            <Button x:Name="NextPage" 
                    Content="Перейти в корзину" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Right" 
                    Margin="25,0"
                    Height="40"
                    FontSize="14" 
                    FontWeight="Bold"
                    Click="NextPage_Click"
                    Background="#2C3E50"
                    Foreground="White"
                    BorderThickness="0"
                    Width="150"/>
        </Border>
    </Grid>
</Page>