<Page x:Class="Anastasia423WPF.NewFolder1.Products"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.NewFolder1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Products">
    <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid Background="#FF672E2E">
                    <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="HARRY POTTER" VerticalAlignment="Top" FontSize="33" Foreground="#FFD0ACAC"/>
                    <Image Source="/Images/Шарф.jpg"  HorizontalAlignment="Left" Margin="28,90,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.493,0.186" Height="120" Width="150"/>
                    <TextBlock x:Name="Sharf" HorizontalAlignment="Left" Margin="67,228,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16" RenderTransformOrigin="0.097,0.608" Foreground="#FFBDBDBD"/>
                    <Image Source="/Images/PALOCIKA.jpg" HorizontalAlignment="Left" Margin="214,90,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.493,0.186" Height="126" Width="160"/>
                    <TextBlock x:Name="Palochka" HorizontalAlignment="Left" Margin="261,221,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16" Foreground="#FFD0ACAC"/>
                    <Image Source="/Images/mantia.jpg" HorizontalAlignment="Left" Height="119" Margin="427,93,0,0" VerticalAlignment="Top" Width="117" RenderTransformOrigin="0.662,0.549"/>
                    <TextBlock x:Name="MantiaNevidimka" HorizontalAlignment="Left" Margin="453,221,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16" Foreground="#FFD0ACAC"/>
                    <Image Source="/Images/UCEBNIC.jpg" HorizontalAlignment="Left" Height="118" Margin="596,93,0,0" VerticalAlignment="Top" Width="169"/>
                    <TextBlock x:Name="Book" HorizontalAlignment="Left" Margin="644,221,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" FontSize="16" Foreground="#FFD0ACAC"/>
                    <Button Content="Button" HorizontalAlignment="Left" Margin="57,269,0,0" VerticalAlignment="Top" Height="25" Width="86" Background="#FF000275"/>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel/>
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
    </ListBox>
</Page>
