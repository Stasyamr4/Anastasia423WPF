<Page x:Class="Anastasia423WPF.NewFolder1.Products"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.NewFolder1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Products">

    <Grid Background="#FFF5F5F5">
        <ListBox x:Name="listBox" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="10">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#FF8B4513" 
                            BorderThickness="1"
                            CornerRadius="5"
                            Background="White"
                            Margin="10"
                            Width="250"
                            Height="280">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="150"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Картинка товара -->
                            <Image Source="{Binding ImagePath}" 
                                   Grid.Row="0"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Width="180"
                                   Height="120"/>

                            <!-- Информация о товаре -->
                            <StackPanel Grid.Row="1" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        Margin="10">
                                <TextBlock Text="{Binding Name}" 
                                           HorizontalAlignment="Center" 
                                           TextWrapping="Wrap"
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Foreground="#FF8B4513"/>

                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0:C}'}" 
                                           HorizontalAlignment="Center"
                                           FontSize="14" 
                                           Foreground="Black"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Кнопка добавить в корзину -->
                            <Button Grid.Row="2"
                                    x:Name="ToBasket" 
                                    Content="Добавить в корзину" 
                                    Margin="20,0,20,15"
                                    Padding="8"
                                    Click="ToBasket_Click"
                                    Tag="{Binding ID}"
                                    Background="#FF8B4513"
                                    Foreground="White"
                                    BorderThickness="0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Кнопка перехода к корзине -->
        <Button x:Name="NextPage" 
                Content="Перейти в корзину" 
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Right" 
                Margin="20"
                Width="140" 
                Height="40"
                FontSize="14" 
                Click="NextPage_Click"
                Background="#FF8B4513"
                Foreground="White"
                BorderThickness="0"/>

    </Grid>
</Page>