<Page x:Class="Anastasia423WPF.Pages.Catalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Catalog">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#FFE47979"/>
                <GradientStop Color="#FFFFF6CD" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Button x:Name="AuthUser" Width="40" Height="35" FontSize="20" Background="#FF383131"  FontWeight="Thin" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,30,0" Click="AuthUser_Click">👤</Button>
        <Button x:Name="Back" Width="100" Height="35" FontSize="20" Background="#FF803F3F" FontWeight="Thin" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,30" Click="Back_Click">Назад</Button>
    </Grid>
</Page>
