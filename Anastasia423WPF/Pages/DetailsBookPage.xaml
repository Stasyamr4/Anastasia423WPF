<Page x:Class="Anastasia423WPF.Pages.DetailsBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Книга" Background="#F5EFE6">
    <ScrollViewer Background="#F5EFE6" Padding="25,20">
        <StackPanel>
            <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#E0D0BC" BorderThickness="1" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="#C8A882" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True">
                        <Image Source="{Binding Picture}" Height="310" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="25,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="28" FontFamily="Georgia" Foreground="#3D2B1F" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding user_.Name, StringFormat='Автор: {0}'}" FontSize="15" Foreground="#7A6048" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding GenresDisplay}" FontSize="13" Foreground="#A08060" Margin="0,0,0,10"/>
                        <Border Background="#FFF8F0" CornerRadius="6" Padding="12,8" BorderBrush="#E8D5B7" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtBlockRating" Text="{Binding Rating, StringFormat='⭐ {0} / 5'}" FontSize="18" Foreground="#B07030" FontWeight="SemiBold"/>
                        </Border>
                        <Rectangle Height="1" Fill="#E0D0BC" Margin="0,16,0,14"/>
                        <TextBlock Text="Описание" Foreground="#5C3D2E" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Description}" Foreground="#4A3828" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                        <TextBlock Text="Статус чтения:" Foreground="#8C7B6B" FontSize="12" Margin="0,18,0,5"/>
                        <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="#FDFAF6" HorizontalAlignment="Left">
                            <ComboBox x:Name="ComboStatus" Width="200" Height="32" BorderThickness="0" Background="Transparent" Padding="8,0" FontSize="13" SelectedValuePath="ID" DisplayMemberPath="Name" SelectionChanged="ComboStatus_SelectionChanged" Loaded="ComboStatus_Loaded" Tag="{Binding ID}"/>
                        </Border>
                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="Читать" Width="110" Height="38" Margin="0,0,10,8" Click="BtnRead_Click" Cursor="Hand" Foreground="White" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#5C3D2E" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3D2B1F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Оставить отзыв" Width="130" Height="38" Margin="0,0,10,8" Click="ReviewBut_Click" Cursor="Hand" Foreground="White" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#7A9E7E" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#5C7D60"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Жалоба на книгу" Height="38" Padding="12,0" Margin="0,0,10,8" Click="ReportBook_Click" Cursor="Hand" Background="#FFF0E8" Foreground="#8C4030" BorderBrush="#E0B8A8" BorderThickness="1" FontSize="12"/>
                            <Button Content="Жалоба на автора" Height="38" Padding="12,0" Margin="0,0,10,8" Click="ReportAuthor_Click" Cursor="Hand" Background="#FFF0E8" Foreground="#8C4030" BorderBrush="#E0B8A8" BorderThickness="1" FontSize="12"/>

                            <Button Content="{Binding FreezeActionText}" Visibility="{Binding AdminVisibility}" Height="38" Padding="12,0" Margin="0,0,0,8" Click="AdminFreeze_Click" Cursor="Hand" Background="#C0392B" Foreground="White" BorderThickness="0" FontSize="12"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Отзывы читателей" FontSize="20" FontFamily="Georgia" Foreground="#3D2B1F" Margin="0,0,0,12"/>
            <Rectangle Height="2" Fill="#C8A882" Margin="0,0,0,16" HorizontalAlignment="Left" Width="160"/>
            <ListBox x:Name="LBoxReviews" Background="Transparent" BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="10" Margin="0,0,0,12" Padding="16,14" BorderBrush="#E0D0BC" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding user_.Login}" FontWeight="SemiBold" Foreground="#5C3D2E" FontSize="14"/>
                                    <TextBlock Text="{Binding Mark, StringFormat='⭐ {0}/5'}" HorizontalAlignment="Right" Foreground="#B07030" FontWeight="SemiBold" FontSize="14"/>
                                </Grid>
                                <TextBlock Text="{Binding Description}" Foreground="#4A3828" Margin="0,8,0,10" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Пожаловаться" FontSize="11" Padding="8,4" Click="ReportReview_Click" Tag="{Binding}" Background="#FFF0E8" Foreground="#8C4030" BorderBrush="#E0B8A8" BorderThickness="1"/>
                                    <Button Content="Заморозить (адм.)" Visibility="{Binding AdminVisibility}" FontSize="11" Padding="8,4" Margin="8,0,0,0" Click="AdminFreezeReview_Click" Tag="{Binding}" Background="#C0392B" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</Page>
