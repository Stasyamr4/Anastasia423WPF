<Page x:Class="Anastasia423WPF.Pages.ReadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Чтение книги" Background="#F5EFE6">
    <Grid Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="← Назад" HorizontalAlignment="Left" Click="Back_Click" Background="Transparent" Foreground="#5C3D2E" BorderThickness="0" FontSize="13" Cursor="Hand" Padding="0" Margin="0,0,0,10"/>
            <TextBlock x:Name="TBlockBookName" FontSize="26" FontFamily="Georgia" Foreground="#3D2B1F" FontWeight="Normal" Text="Название книги" TextWrapping="Wrap"/>
            <Rectangle Height="2" Fill="#C8A882" Margin="0,8,0,0" HorizontalAlignment="Left" Width="200"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E0D0BC" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#C8A882" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>
            <ScrollViewer Padding="30,25">
                <TextBlock x:Name="TBlockContent" Foreground="#2C1F14" FontSize="15" TextWrapping="Wrap" LineHeight="26" FontFamily="Georgia" Text="Здесь будет текст книги..."/>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Написать отзыв и поставить оценку" HorizontalAlignment="Left" Height="42" Padding="20,0" Background="#5C3D2E" Foreground="White" BorderThickness="0" FontSize="13" Cursor="Hand" Click="OpenReviewWindow_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D2B1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Page>