<Page x:Class="Anastasia423WPF.Pages.Option"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Option">

    <Grid OpacityMask="#FFE6DEDE" Background="#FFA1D29D">
        <CheckBox x:Name="Kondi" Margin="169,116,0,300" HorizontalAlignment="Left" Content="Кондиционер" FontSize="16" Checked="Kondi_Checked" Unchecked="Kondi_Unchecked"></CheckBox>
        <TextBlock x:Name="TopPrice" Margin="258,315,0,104" HorizontalAlignment="Left" Text="Итоговая стоимость машины: " FontSize="16"></TextBlock>
        <CheckBox x:Name="Lampa" Margin="169,172,0,242" HorizontalAlignment="Left" Content="Лампочка" FontSize="16" Checked="Kondi_Checked" Unchecked="Kondi_Unchecked"/>
        <CheckBox x:Name="luk" Margin="169,225,0,190" HorizontalAlignment="Left" Content="Люк" FontSize="16" Checked="Kondi_Checked" Unchecked="Kondi_Unchecked"/>
        <ComboBox x:Name="CarColor" HorizontalAlignment="Left" Margin="420,117,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="ComboBox_SelectionChanged"/>
        <Button Content="Далее" HorizontalAlignment="Left" Margin="653,386,0,0" VerticalAlignment="Top" Background="#FF676569" FontSize="18" Height="30" Width="95" Click="Button_Click"/>

    </Grid>
</Page>
