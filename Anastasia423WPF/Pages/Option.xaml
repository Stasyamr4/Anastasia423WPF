<Page x:Class="Anastasia423WPF.Pages.Option"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Option">

    <Grid OpacityMask="#FFE6DEDE" Background="#FFA1D29D">
        <CheckBox x:Name="Kondi" Margin="48,78,0,337" HorizontalAlignment="Left" Content="Кондиционер" FontSize="16" Checked="Kondi_Checked" Unchecked="Kondi_Unchecked"></CheckBox>
        <TextBlock x:Name="TopPrice" Margin="0,353,0,66" HorizontalAlignment="Center" Text="Итоговая стоимость машины: " FontSize="16"></TextBlock>
        <CheckBox x:Name="Lampa" Margin="48,133,0,282" HorizontalAlignment="Left" Content="Лампочка" FontSize="16" Checked="Lampa_Checked" Unchecked="Lampa_Unchecked"/>
        <CheckBox x:Name="luk" Margin="48,190,0,225" HorizontalAlignment="Left" Content="Люк" FontSize="16" Checked="luk_Checked" Unchecked="luk_Unchecked"/>

    </Grid>
</Page>
