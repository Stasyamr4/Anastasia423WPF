<Window x:Class="OhmsLawCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вариант №16 - Калькулятор закона Ома" Height="450" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Text="Применение закона Ома" 
                   FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Напряжение -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Напряжение (В):" 
                   VerticalAlignment="Center" Margin="0,5" FontSize="14"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtVoltage" 
                 Margin="0,5" Padding="5" FontSize="14"/>

        <!-- Сила тока -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Сила тока (А):" 
                   VerticalAlignment="Center" Margin="0,5" FontSize="14"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCurrent" 
                 Margin="0,5" Padding="5" FontSize="14"/>

        <!-- Сопротивление -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Сопротивление (Ом):" 
                   VerticalAlignment="Center" Margin="0,5" FontSize="14"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtResistance" 
                 Margin="0,5" Padding="5" FontSize="14"/>

        <!-- Выбор что вычислять -->
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                   Text="Вычисляемая величина:" 
                   Margin="0,20,0,10" FontSize="14" FontWeight="Bold"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Vertical" Margin="0,0,0,20">
            <RadioButton x:Name="rbCurrent" Content="Сила тока (I = U/R)" IsChecked="True" Margin="0,5" FontSize="14"/>
            <RadioButton x:Name="rbVoltage" Content="Напряжение (U = I×R)" Margin="0,5" FontSize="14"/>
            <RadioButton x:Name="rbResistance" Content="Сопротивление (R = U/I)" Margin="0,5" FontSize="14"/>
        </StackPanel>

        <!-- Кнопки -->
        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="Вычислить" Height="40" Width="200"
                Click="BtnCalculate_Click"
                FontSize="16" FontWeight="Bold"
                Margin="0,10"
                Background="DimGray"
                Foreground="White"/>

        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="Очистить" Height="35" Width="150"
                Click="BtnClear_Click"
                FontSize="14"
                Margin="0,10"
                VerticalAlignment="Top"/>
    </Grid>
</Window>