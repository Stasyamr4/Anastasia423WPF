<Window x:Class="Anastasia423WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anastasia423WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="Black"/>
                <GradientStop Color="#FFEDC1DF" Offset="1"/>
                <GradientStop Color="#FFDEC49D" Offset="0"/>
            </RadialGradientBrush>
        </Grid.Background>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="Title" FontSize="36" FontWeight="Thin"  Foreground="#FF6F1717">Косметическая ложа</TextBlock>
            <Button x:Name="LoginButton" Background="#FFECDA87" FontSize="22" Margin="0,40,0,0" Foreground="#FF6F1717" Padding="10" Click="LoginButton_Click">Вход</Button>
        </StackPanel>
    </Grid>
</Window>
