<Window x:Class="Anastasia423WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF1E1A2F" Width="80">
            <StackPanel Margin="0,20,0,0">
                <Button x:Name="BtnCatalog" ToolTip="Каталог книг" Click="BtnCatalog_Click" Margin="0,20,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel>
                                <Image Source="/Images/catalog.png" Width="48" Height="48"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnLists" ToolTip="Списки книг" Click="BtnLists_Click" Margin="0,10">
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <Image Source="/Images/lists.png" Width="48" Height="48"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button>
                <Button x:Name="BtnAdmin" ToolTip="Администрирование" Click="BtnAdmin_Click" Margin="0,10" Visibility="Collapsed">
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <Image Source="/Images/admin.png" Width="48" Height="48"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button>
                <Button x:Name="BtnAuthor" ToolTip="Страница автора" Click="BtnAuthor_Click" Margin="0,10" Visibility="Collapsed">
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <Image Source="/Images/author.png" Width="48" Height="48"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button>
                <Button x:Name="BtnFreezeWarning" ToolTip="Аккаунт заморожен" Click="BtnFreezeWarning_Click" Margin="0,10" Visibility="Collapsed" Background="OrangeRed">
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <Image Source="/Images/freeze_warning.png" Width="48" Height="48"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button>
                <Button x:Name="BtnProfile" ToolTip="Профиль" Click="BtnProfile_Click" Margin="0,10">
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <Image Source="/Images/profile.png" Width="48" Height="48"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button>
            </StackPanel>
        </Border>

        <!-- Основная область (Frame для страниц) -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
