<Window x:Class="Anastasia423WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anastasia423WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Frame x:Name="MainFrame" Grid.Row="1" Source="Pages/Products.xaml" NavigationUIVisibility="Hidden"/>
        <Button x:Name="PreviousPage" Width="100" Content="Назад" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30" Click="PreviousPage_Click"></Button>
    </Grid>
</Window>
