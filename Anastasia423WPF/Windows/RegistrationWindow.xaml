<Window x:Class="Anastasia423WPF.Windows.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anastasia423WPF.Windows"
        mc:Ignorable="d"
        Title="Регистрация — Читай, Пиши и не спиши" Height="530" Width="820"
        WindowStartupLocation="CenterScreen" Background="#F5EFE6">

    <Grid>
        <Border Width="280" HorizontalAlignment="Left" Background="#3D2B1F">
            <StackPanel VerticalAlignment="Center" Margin="30">
                <TextBlock Text="📖" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="Читай, Пиши" FontFamily="Georgia" FontSize="22" Foreground="#E8D5B7" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="и не спиши" FontFamily="Georgia" FontSize="18" Foreground="#A08060" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                <TextBlock Text="Присоединяйтесь к нашему книжному сообществу — читайте, делитесь впечатлениями, открывайте новые миры." Foreground="#C8A882" TextWrapping="Wrap" FontSize="12" TextAlignment="Center" LineHeight="20"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="310,0,30,0" VerticalAlignment="Center">
            <TextBlock Text="Создать аккаунт" FontSize="24" FontFamily="Georgia" Foreground="#3D2B1F" Margin="0,0,0,4"/>
            <TextBlock Text="Заполните поля ниже" FontSize="12" Foreground="#8C7B6B" Margin="0,0,0,22"/>
            <TextBlock Text="Логин" Foreground="#5C3D2E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="5" Background="White" Margin="0,0,0,4">
                <TextBox x:Name="LoginText" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" LostFocus="LoginText_LostFocus"/>
            </Border>
            <TextBlock x:Name="LoginError" Foreground="#B94040" FontSize="11" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBlock Text="Пароль" Foreground="#5C3D2E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="5" Background="White" Margin="0,0,0,4">
                <PasswordBox x:Name="PassText" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" LostFocus="PassText_LostFocus"/>
            </Border>
            <TextBlock x:Name="PassError" Foreground="#B94040" FontSize="11" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBlock Text="Подтвердите пароль" Foreground="#5C3D2E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="5" Background="White" Margin="0,0,0,4">
                <PasswordBox x:Name="PassVerificText" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" LostFocus="PassVerificText_LostFocus"/>
            </Border>
            <TextBlock x:Name="PassVerificError" Foreground="#B94040" FontSize="11" Visibility="Collapsed" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ФИО" Foreground="#5C3D2E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="5" Background="White" Margin="0,0,0,4">
                        <TextBox x:Name="FIOText" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" LostFocus="FIOText_LostFocus"/>
                    </Border>
                    <TextBlock x:Name="FIOError" Foreground="#B94040" FontSize="11" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Email" Foreground="#5C3D2E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="5" Background="White" Margin="0,0,0,4">
                        <TextBox x:Name="EmailText" Height="34" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" LostFocus="PhoneText_LostFocus"/>
                    </Border>
                    <TextBlock x:Name="EmailError" Foreground="#B94040" FontSize="11" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
            <Button x:Name="RegistrUser" Height="42" Margin="0,22,0,10" Background="#5C3D2E" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="RegistrUser_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D2B1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                Зарегистрироваться
            </Button>
            <Button x:Name="Back" Background="Transparent" BorderThickness="0" Foreground="#8C7B6B" FontSize="13" HorizontalAlignment="Center" Cursor="Hand" Click="Back_Click">
                ← Назад ко входу
            </Button>
        </StackPanel>
    </Grid>
</Window>
