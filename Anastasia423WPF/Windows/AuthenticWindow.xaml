<Window x:Class="Anastasia423WPF.Windows.AuthenticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anastasia423WPF"
        mc:Ignorable="d"
        Title="Вход — Читай, Пиши и не спиши" Height="480" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5EFE6">

    <Grid>
        <Rectangle Width="6" HorizontalAlignment="Left" Fill="#5C3D2E"/>
        <Rectangle Width="6" HorizontalAlignment="Right" Fill="#5C3D2E"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="📖" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Добро пожаловать" FontSize="22" FontFamily="Georgia" FontWeight="Normal" Foreground="#3D2B1F" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Войдите, чтобы продолжить чтение" FontSize="12" Foreground="#8C7B6B" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            <TextBlock Text="Логин" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="White">
                <TextBox x:Name="LoginText" Height="36" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="14" Foreground="#3D2B1F"/>
            </Border>
            <TextBlock Text="Пароль" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,5"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="White">
                <PasswordBox x:Name="PassText" Height="36" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="14" Foreground="#3D2B1F"/>
            </Border>
            <Button x:Name="Enter" Height="42" Margin="0,28,0,0" Background="#5C3D2E" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="Enter_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D2B1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                Войти
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="Нет аккаунта? " FontSize="13" Foreground="#8C7B6B"/>
                <Button x:Name="Registr" Background="Transparent" BorderThickness="0" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="Registr_Click">
                    Зарегистрироваться
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
