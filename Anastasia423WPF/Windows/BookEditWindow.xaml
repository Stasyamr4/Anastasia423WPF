<Window x:Class="Anastasia423WPF.Windows.BookEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anastasia423WPF.Windows"
        mc:Ignorable="d"
        Title="Редактор книги" Height="780" Width="820"
        Background="#F5EFE6" WindowStartupLocation="CenterScreen">
    <ScrollViewer Padding="30,24">
        <StackPanel>
            <TextBlock Text="Редактировать книгу" FontSize="22" FontFamily="Georgia" Foreground="#3D2B1F" Margin="0,0,0,6"/>
            <Rectangle Height="2" Fill="#C8A882" HorizontalAlignment="Left" Width="160" Margin="0,0,0,22"/>
            <TextBlock Text="Название книги" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,16">
                <TextBox x:Name="TBoxName" Height="36" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="14" Foreground="#3D2B1F"/>
            </Border>
            <TextBlock Text="Описание (аннотация)" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,16">
                <TextBox x:Name="TBoxDescription" Height="70" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,8" FontSize="13" Foreground="#3D2B1F" VerticalContentAlignment="Top"/>
            </Border>
            <TextBlock Text="Ссылка на обложку" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,16">
                <TextBox x:Name="TBoxPicture" Height="36" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="13" Foreground="#3D2B1F"/>
            </Border>
            <TextBlock Text="Жанры" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,16">
                <ListBox x:Name="LBoxGenres" Height="90" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" Foreground="#3D2B1F" IsChecked="{Binding IsSelected}" Margin="5,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <TextBlock Text="Текст произведения" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,22">
                <TextBox x:Name="TBoxContent" Height="180" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10,8" FontSize="13" Foreground="#3D2B1F" VerticalContentAlignment="Top" FontFamily="Georgia"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="90" Height="40" Margin="0,0,12,0" Click="Cancel_Click" Background="#FFF0E8" Foreground="#8C4030" BorderBrush="#E0B8A8" BorderThickness="1" Cursor="Hand"/>
                <Button Content="Сохранить книгу" Width="140" Height="40" Click="Save_Click" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#5C3D2E" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3D2B1F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
