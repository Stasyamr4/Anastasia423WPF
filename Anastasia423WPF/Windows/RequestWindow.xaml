<Window x:Class="Anastasia423WPF.Windows.RequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anastasia423WPF.Windows"
        mc:Ignorable="d"
        Title="Заявка на роль автора" Height="340" Width="520"
        WindowStartupLocation="CenterOwner" Background="#F5EFE6">

    <Grid Margin="30,26">
        <StackPanel>
            <TextBlock Text="Заявка на роль автора" FontSize="20" FontFamily="Georgia" Foreground="#3D2B1F" Margin="0,0,0,6"/>
            <TextBlock Text="Расскажите немного о себе и своих работах" FontSize="12" Foreground="#8C7B6B" Margin="0,0,0,20"/>
            <TextBlock Text="Текст запроса" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,22">
                <TextBox x:Name="TBoxReviewText" Height="120" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10,8" FontSize="13" Foreground="#3D2B1F" VerticalContentAlignment="Top"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="90" Height="40" Margin="0,0,12,0" Click="Cancel_Click" Background="#FFF0E8" Foreground="#8C4030" BorderBrush="#E0B8A8" BorderThickness="1" FontSize="13" Cursor="Hand"/>
                <Button Content="Отправить" Width="120" Height="40" Click="Save_Click" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#5C3D2E" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3D2B1F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>