<Window x:Class="Anastasia423WPF.Windows.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Написать отзыв" Height="380" Width="420"
        WindowStartupLocation="CenterOwner" Background="#F5EFE6">

    <Grid Margin="28,24">
        <StackPanel>
            <TextBlock Text="Ваш отзыв" FontSize="20" FontFamily="Georgia" Foreground="#3D2B1F" Margin="0,0,0,4"/>
            <Rectangle Height="2" Fill="#C8A882" HorizontalAlignment="Left" Width="80" Margin="0,0,0,20"/>
            <TextBlock Text="Оценка" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6"
                    Background="White" HorizontalAlignment="Left" Margin="0,0,0,18">
                <ComboBox x:Name="ComboRating" Width="80" Height="34" BorderThickness="0" Background="Transparent" Padding="10,0" FontSize="14">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5" IsSelected="True"/>
                </ComboBox>
            </Border>
            <TextBlock Text="Текст отзыва" Foreground="#5C3D2E" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderBrush="#C8A882" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,22">
                <TextBox x:Name="TBoxReviewText" Height="110" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10,8" FontSize="13" Foreground="#3D2B1F" VerticalContentAlignment="Top"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="90" Height="38" Margin="0,0,12,0" Click="Cancel_Click" Background="#FFF0E8" Foreground="#8C4030" BorderBrush="#E0B8A8" BorderThickness="1" Cursor="Hand"/>
                <Button Content="Сохранить" Width="110" Height="38" Click="Save_Click" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#5C3D2E" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3D2B1F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>